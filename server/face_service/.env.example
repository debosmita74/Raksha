# Copy to .env on the Raspberry Pi only. Use long random values.
RAKSHA_ADMIN_TOKEN=replace_with_long_random_admin_secret
RAKSHA_API_TOKEN=replace_with_a_different_long_random_api_secret

# IPs of your camera and main ESP32 on a reserved/private LAN.
RAKSHA_CAMERA_URL=http://192.168.1.50/capture
RAKSHA_ESP32_URL=http://192.168.1.51/api/access

# Conservative LBPH distance threshold; calibrate with your own data.
RAKSHA_LBPH_THRESHOLD=55
RAKSHA_MIN_STABLE_MATCHES=3
RAKSHA_POLL_SECONDS=1.0

# SAFE DEFAULT. Match-only access is not spoof-resistant.
# Keep false until you have added and validated a separate liveness/second-factor method.
RAKSHA_ENABLE_MATCH_ONLY_ACCESS=false

# Keep biometric data on a private local disk.
RAKSHA_DATA_DIR=/home/pi/raksha-data
